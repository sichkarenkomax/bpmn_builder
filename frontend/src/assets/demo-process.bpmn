<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Demo" targetNamespace="http://bpmn-studio.dev/schema">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Client" name="Клиент" processRef="Process_Client"/>
    <bpmn:participant id="Participant_Bank" name="Банк" processRef="Process_Bank"/>
    <bpmn:messageFlow id="Message_1" name="Заявка" sourceRef="Participant_Client" targetRef="Participant_Bank"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Client" name="Клиент" isExecutable="false">
    <bpmn:laneSet id="Process_Client_laneSet">
      <bpmn:lane id="Lane_Client" name="Клиент">
        <bpmn:flowNodeRef>Client_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Client_Task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Client_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Client_Gateway</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Client_Start" name="Нужен кредит"/>
    <bpmn:userTask id="Client_Task" name="Заполнить заявку"/>
    <bpmn:userTask id="Client_Check" name="Проверить условия"/>
    <bpmn:exclusiveGateway id="Client_Gateway" name="Условия подходят?"/>
    <bpmn:endEvent id="Client_End_Yes" name="Отправить в банк"/>
    <bpmn:endEvent id="Client_End_No" name="Отказано"/>
    <bpmn:sequenceFlow id="Client_Flow_1" sourceRef="Client_Start" targetRef="Client_Task"/>
    <bpmn:sequenceFlow id="Client_Flow_2" sourceRef="Client_Task" targetRef="Client_Check"/>
    <bpmn:sequenceFlow id="Client_Flow_3" sourceRef="Client_Check" targetRef="Client_Gateway"/>
    <bpmn:sequenceFlow id="Client_Flow_Yes" name="Да" sourceRef="Client_Gateway" targetRef="Client_End_Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Client_Flow_No" name="Нет" sourceRef="Client_Gateway" targetRef="Client_End_No"/>
  </bpmn:process>
  <bpmn:process id="Process_Bank" name="Банк" isExecutable="true">
    <bpmn:laneSet id="Process_Bank_laneSet">
      <bpmn:lane id="Lane_Bank" name="Банк">
        <bpmn:flowNodeRef>Bank_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bank_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bank_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Bank_Start" name="Заявка получена"/>
    <bpmn:serviceTask id="Bank_Score" name="Рассчитать скоринг" implementation="ScoringConnector"/>
    <bpmn:endEvent id="Bank_End" name="Решение принято"/>
    <bpmn:sequenceFlow id="Bank_Flow_1" sourceRef="Bank_Start" targetRef="Bank_Score"/>
    <bpmn:sequenceFlow id="Bank_Flow_2" sourceRef="Bank_Score" targetRef="Bank_End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Collaboration">
    <bpmndi:BPMNPlane id="Plane_Collaboration" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Client_di" bpmnElement="Participant_Client" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="860" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Bank_di" bpmnElement="Participant_Bank" isHorizontal="true">
        <dc:Bounds x="130" y="300" width="860" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Client_di" bpmnElement="Lane_Client" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="800" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Client_Start_di" bpmnElement="Client_Start">
        <dc:Bounds x="200" y="160" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Client_Task_di" bpmnElement="Client_Task">
        <dc:Bounds x="290" y="138" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Client_Check_di" bpmnElement="Client_Check">
        <dc:Bounds x="440" y="138" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Client_Gateway_di" bpmnElement="Client_Gateway">
        <dc:Bounds x="590" y="153" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Client_End_Yes_di" bpmnElement="Client_End_Yes">
        <dc:Bounds x="700" y="110" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Client_End_No_di" bpmnElement="Client_End_No">
        <dc:Bounds x="700" y="210" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Client_Flow_1_di" bpmnElement="Client_Flow_1">
        <di:waypoint x="236" y="178"/>
        <di:waypoint x="290" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Client_Flow_2_di" bpmnElement="Client_Flow_2">
        <di:waypoint x="390" y="178"/>
        <di:waypoint x="440" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Client_Flow_3_di" bpmnElement="Client_Flow_3">
        <di:waypoint x="540" y="178"/>
        <di:waypoint x="590" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Client_Flow_Yes_di" bpmnElement="Client_Flow_Yes">
        <di:waypoint x="640" y="178"/>
        <di:waypoint x="670" y="178"/>
        <di:waypoint x="670" y="128"/>
        <di:waypoint x="700" y="128"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Client_Flow_No_di" bpmnElement="Client_Flow_No">
        <di:waypoint x="640" y="178"/>
        <di:waypoint x="670" y="178"/>
        <di:waypoint x="670" y="228"/>
        <di:waypoint x="700" y="228"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Lane_Bank_di" bpmnElement="Lane_Bank" isHorizontal="true">
        <dc:Bounds x="160" y="320" width="800" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bank_Start_di" bpmnElement="Bank_Start">
        <dc:Bounds x="200" y="400" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bank_Score_di" bpmnElement="Bank_Score">
        <dc:Bounds x="290" y="378" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bank_End_di" bpmnElement="Bank_End">
        <dc:Bounds x="440" y="400" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Bank_Flow_1_di" bpmnElement="Bank_Flow_1">
        <di:waypoint x="236" y="418"/>
        <di:waypoint x="290" y="418"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Bank_Flow_2_di" bpmnElement="Bank_Flow_2">
        <di:waypoint x="390" y="418"/>
        <di:waypoint x="440" y="418"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_1_di" bpmnElement="Message_1">
        <di:waypoint x="420" y="300"/>
        <di:waypoint x="420" y="260"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
