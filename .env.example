# Скопируйте в .env: cp .env.example .env
# Значения по умолчанию рассчитаны на локальный docker compose.

ENVIRONMENT=local
DEBUG=false
APP_VERSION=0.3.0
DOCS_ENABLED=true
TRUST_PROXY_HEADERS=false

# Прикладные модули через запятую; пусто — только ядро. Доступны: pilot.
MODULES_ENABLED=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=20
MAX_REQUEST_BODY_BYTES=12582912

POSTGRES_DB=bpmn
POSTGRES_USER=bpmn
POSTGRES_PASSWORD=bpmn

# Для запуска бэкенда вне compose замените хосты на localhost.
DATABASE_URL=postgresql+asyncpg://bpmn:bpmn@postgres:5432/bpmn
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=bpmn-studio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

CORS_ORIGINS=["http://localhost","http://localhost:5173"]
