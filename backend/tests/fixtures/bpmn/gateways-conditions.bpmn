<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Gateways"
                  targetNamespace="http://bpmn-studio.dev/schema">
  <bpmn:process id="Process_Gateways" name="Разветвление" isExecutable="true">
    <bpmn:startEvent id="Start_1">
      <bpmn:outgoing>To_Split</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Parallel_Split">
      <bpmn:incoming>To_Split</bpmn:incoming>
      <bpmn:outgoing>To_A</bpmn:outgoing>
      <bpmn:outgoing>To_B</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_A" name="Ветка A">
      <bpmn:incoming>To_A</bpmn:incoming>
      <bpmn:outgoing>From_A</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_B" name="Ветка B">
      <bpmn:incoming>To_B</bpmn:incoming>
      <bpmn:outgoing>From_B</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Exclusive_Merge" name="Слить">
      <bpmn:incoming>From_A</bpmn:incoming>
      <bpmn:incoming>From_B</bpmn:incoming>
      <bpmn:outgoing>To_Inclusive</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="Inclusive_1" name="Любой из">
      <bpmn:incoming>To_Inclusive</bpmn:incoming>
      <bpmn:outgoing>To_End</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="End_1">
      <bpmn:incoming>To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="To_Split" sourceRef="Start_1" targetRef="Parallel_Split" />
    <bpmn:sequenceFlow id="To_A" sourceRef="Parallel_Split" targetRef="Task_A" />
    <bpmn:sequenceFlow id="To_B" sourceRef="Parallel_Split" targetRef="Task_B" />
    <bpmn:sequenceFlow id="From_A" sourceRef="Task_A" targetRef="Exclusive_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &lt; 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="From_B" sourceRef="Task_B" targetRef="Exclusive_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &gt;= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="To_Inclusive" sourceRef="Exclusive_Merge" targetRef="Inclusive_1" />
    <bpmn:sequenceFlow id="To_End" sourceRef="Inclusive_1" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_Gateways">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="80" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Parallel_Split_di" bpmnElement="Parallel_Split">
        <dc:Bounds x="160" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_di" bpmnElement="Task_A">
        <dc:Bounds x="250" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B_di" bpmnElement="Task_B">
        <dc:Bounds x="250" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Exclusive_Merge_di" bpmnElement="Exclusive_Merge" isMarkerVisible="true">
        <dc:Bounds x="400" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inclusive_1_di" bpmnElement="Inclusive_1">
        <dc:Bounds x="490" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="580" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="To_Split_di" bpmnElement="To_Split">
        <di:waypoint x="116" y="170" />
        <di:waypoint x="160" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="To_A_di" bpmnElement="To_A">
        <di:waypoint x="210" y="170" />
        <di:waypoint x="230" y="170" />
        <di:waypoint x="230" y="100" />
        <di:waypoint x="250" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="To_B_di" bpmnElement="To_B">
        <di:waypoint x="210" y="170" />
        <di:waypoint x="230" y="170" />
        <di:waypoint x="230" y="240" />
        <di:waypoint x="250" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="From_A_di" bpmnElement="From_A">
        <di:waypoint x="350" y="100" />
        <di:waypoint x="425" y="100" />
        <di:waypoint x="425" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="From_B_di" bpmnElement="From_B">
        <di:waypoint x="350" y="240" />
        <di:waypoint x="425" y="240" />
        <di:waypoint x="425" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="To_Inclusive_di" bpmnElement="To_Inclusive">
        <di:waypoint x="450" y="170" />
        <di:waypoint x="490" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="To_End_di" bpmnElement="To_End">
        <di:waypoint x="540" y="170" />
        <di:waypoint x="580" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
