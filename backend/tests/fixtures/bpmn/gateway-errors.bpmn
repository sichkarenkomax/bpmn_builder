<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_GatewayErrors"
                  targetNamespace="http://bpmn-studio.dev/schema">
  <bpmn:process id="Process_GatewayErrors" name="Ошибки шлюза" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Начало" />
    <bpmn:exclusiveGateway id="Gateway_1" name="Развилка" />
    <bpmn:userTask id="Task_A" name="Ветка A" />
    <bpmn:userTask id="Task_B" name="Ветка B" />
    <bpmn:endEvent id="End_1" name="Конец" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_1" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Gateway_1" targetRef="Task_A">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                xsi:type="bpmn:tFormalExpression">amount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Gateway_1" targetRef="Task_B" />
    <bpmn:sequenceFlow id="Flow_EndA" sourceRef="Task_A" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_EndB" sourceRef="Task_B" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_GatewayErrors">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="100" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1">
        <dc:Bounds x="180" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_di" bpmnElement="Task_A">
        <dc:Bounds x="280" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B_di" bpmnElement="Task_B">
        <dc:Bounds x="280" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="440" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="136" y="168" />
        <di:waypoint x="180" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_di" bpmnElement="Flow_A">
        <di:waypoint x="205" y="145" />
        <di:waypoint x="205" y="100" />
        <di:waypoint x="280" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B_di" bpmnElement="Flow_B">
        <di:waypoint x="205" y="195" />
        <di:waypoint x="205" y="240" />
        <di:waypoint x="280" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EndA_di" bpmnElement="Flow_EndA">
        <di:waypoint x="380" y="100" />
        <di:waypoint x="458" y="100" />
        <di:waypoint x="458" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EndB_di" bpmnElement="Flow_EndB">
        <di:waypoint x="380" y="240" />
        <di:waypoint x="458" y="240" />
        <di:waypoint x="458" y="186" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
