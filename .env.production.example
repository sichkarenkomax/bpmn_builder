# Скопируйте в .env.production и задайте собственные секреты.
# Запуск: docker compose --env-file .env.production -f docker-compose.production.yml up -d --build

POSTGRES_DB=bpmn
POSTGRES_USER=bpmn
POSTGRES_PASSWORD=change-me-long-random
REDIS_PASSWORD=change-me-long-random

# Публичный адрес, с которого открывается UI. Нужен для CORS.
PUBLIC_ORIGIN=https://bpmn.example.com
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
